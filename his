import { useEffect, useState } from "react";
import { Link } from "react-router-dom";
import {
  ArrowRight,
  CalendarDays,
  CheckCircle2,
  Clock3,
  FileText,
  History,
  Loader2,
  Target,
  Trophy,
  XCircle,
} from "lucide-react";

interface Exam {
  _id: string;
  title: string;
  slug: string;
}

interface Answer {
  questionId: string;
  selectedAnswer: string | null;
  isCorrect: boolean;
  _id: string;
}

interface QuizAttempt {
  _id: string;
  userId: string;
  examId: Exam;
  score: number;
  totalQuestions?: number;
  answers: Answer[];
  createdAt: string;
  updatedAt: string;
}

interface AttemptsResponse {
  success: boolean;
  count: number;
  attempts: QuizAttempt[];
}

const API_URL = "http://localhost:4000/api";

const QuizHistory = () => {
  const [attempts, setAttempts] = useState<QuizAttempt[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    const fetchAttempts = async () => {
      try {
        setLoading(true);
        setError("");

        const token = localStorage.getItem("token");

        const response = await fetch(`${API_URL}/quiz-attempts/my`, {
          method: "GET",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },
        });

        const data: AttemptsResponse = await response.json();

        if (!response.ok || !data.success) {
          throw new Error("Failed to load quiz history");
        }

        setAttempts(data.attempts || []);
      } catch (err) {
        console.error(err);
        setError("Unable to load your quiz history.");
      } finally {
        setLoading(false);
      }
    };

    fetchAttempts();
  }, []);

  const getTotalQuestions = (attempt: QuizAttempt) => {
    return attempt.totalQuestions || attempt.answers?.length || 25;
  };

  const getCorrectAnswers = (attempt: QuizAttempt) => {
    return attempt.answers?.filter((answer) => answer.isCorrect).length || 0;
  };

  const getAnsweredQuestions = (attempt: QuizAttempt) => {
    return (
      attempt.answers?.filter((answer) => answer.selectedAnswer !== null)
        .length || 0
    );
  };

  const getUnansweredQuestions = (attempt: QuizAttempt) => {
    return getTotalQuestions(attempt) - getAnsweredQuestions(attempt);
  };

  const getPercentage = (attempt: QuizAttempt) => {
    const total = getTotalQuestions(attempt);

    if (!total) return 0;

    return Math.round((attempt.score / total) * 100);
  };

  const getScoreColor = (percentage: number) => {
    if (percentage >= 80) {
      return "text-emerald-500";
    }

    if (percentage >= 50) {
      return "text-amber-500";
    }

    return "text-red-500";
  };

  const getScoreBadge = (percentage: number) => {
    if (percentage >= 80) {
      return "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400";
    }

    if (percentage >= 50) {
      return "bg-amber-500/10 text-amber-600 dark:text-amber-400";
    }

    return "bg-red-500/10 text-red-600 dark:text-red-400";
  };

  const formatDate = (date: string) => {
    return new Date(date).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  };

  const formatTime = (date: string) => {
    return new Date(date).toLocaleTimeString("en-US", {
      hour: "numeric",
      minute: "2-digit",
    });
  };

  if (loading) {
    return (
      <div className="flex min-h-[60vh] items-center justify-center">
        <div className="flex flex-col items-center gap-3">
          <Loader2 className="h-8 w-8 animate-spin text-primary" />
          <p className="text-sm text-muted-foreground">
            Loading your quiz history...
          </p>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="mx-auto flex min-h-[60vh] max-w-3xl items-center justify-center px-4">
        <div className="w-full rounded-2xl border border-red-500/20 bg-red-500/5 p-8 text-center">
          <XCircle className="mx-auto mb-4 h-10 w-10 text-red-500" />

          <h2 className="text-xl font-semibold">Something went wrong</h2>

          <p className="mt-2 text-sm text-muted-foreground">{error}</p>

          <button
            onClick={() => window.location.reload()}
            className="mt-5 rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition hover:opacity-90"
          >
            Try Again
          </button>
        </div>
      </div>
    );
  }

  const totalAttempts = attempts.length;

  const totalCorrect = attempts.reduce(
    (sum, attempt) => sum + getCorrectAnswers(attempt),
    0,
  );

  const totalQuestions = attempts.reduce(
    (sum, attempt) => sum + getTotalQuestions(attempt),
    0,
  );

  const averageScore =
    totalQuestions > 0 ? Math.round((totalCorrect / totalQuestions) * 100) : 0;

  return (
    <main className="min-h-screen bg-background">
      <div className="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8">
        {/* Header */}
        <div className="mb-8">
          <div className="mb-3 flex items-center gap-2 text-sm text-primary">
            <History className="h-4 w-4" />
            <span>Quiz History</span>
          </div>

          <h1 className="text-3xl font-bold tracking-tight sm:text-4xl">
            My Quiz Attempts
          </h1>

          <p className="mt-2 max-w-2xl text-muted-foreground">
            Review your previous quizzes, scores, and detailed results.
          </p>
        </div>

        {/* Stats */}
        {attempts.length > 0 && (
          <div className="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
            {/* Attempts */}
            <div className="rounded-2xl border bg-card p-5 shadow-sm">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm text-muted-foreground">
                    Total Attempts
                  </p>

                  <p className="mt-1 text-2xl font-bold">{totalAttempts}</p>
                </div>

                <div className="rounded-xl bg-primary/10 p-3">
                  <FileText className="h-5 w-5 text-primary" />
                </div>
              </div>
            </div>

            {/* Average */}
            <div className="rounded-2xl border bg-card p-5 shadow-sm">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm text-muted-foreground">
                    Overall Accuracy
                  </p>

                  <p
                    className={`mt-1 text-2xl font-bold ${getScoreColor(
                      averageScore,
                    )}`}
                  >
                    {averageScore}%
                  </p>
                </div>

                <div className="rounded-xl bg-emerald-500/10 p-3">
                  <Target className="h-5 w-5 text-emerald-500" />
                </div>
              </div>
            </div>

            {/* Correct */}
            <div className="rounded-2xl border bg-card p-5 shadow-sm">
              <div className="flex items-center justify-between">
                <div>
                  <p className="text-sm text-muted-foreground">
                    Correct Answers
                  </p>

                  <p className="mt-1 text-2xl font-bold text-emerald-500">
                    {totalCorrect}
                  </p>
                </div>

                <div className="rounded-xl bg-emerald-500/10 p-3">
                  <CheckCircle2 className="h-5 w-5 text-emerald-500" />
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Empty state */}
        {attempts.length === 0 ? (
          <div className="rounded-2xl border bg-card px-6 py-16 text-center shadow-sm">
            <div className="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/10">
              <Trophy className="h-8 w-8 text-primary" />
            </div>

            <h2 className="text-xl font-semibold">No quiz attempts yet</h2>

            <p className="mx-auto mt-2 max-w-md text-sm text-muted-foreground">
              You haven't completed any quizzes yet. Start a quiz and your
              results will appear here.
            </p>

            <Link
              to="/categories"
              className="mt-6 inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-2.5 text-sm font-medium text-primary-foreground transition hover:opacity-90"
            >
              Browse Quizzes
              <ArrowRight className="h-4 w-4" />
            </Link>
          </div>
        ) : (
          /* Attempts */
          <div className="space-y-4">
            {attempts.map((attempt) => {
              const total = getTotalQuestions(attempt);
              const correct = getCorrectAnswers(attempt);
              const answered = getAnsweredQuestions(attempt);
              const unanswered = getUnansweredQuestions(attempt);
              const percentage = getPercentage(attempt);

              return (
                <div
                  key={attempt._id}
                  className="overflow-hidden rounded-2xl border bg-card shadow-sm transition hover:shadow-md"
                >
                  <div className="p-5 sm:p-6">
                    {/* Top */}
                    <div className="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                      <div className="flex gap-4">
                        <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-primary/10">
                          <FileText className="h-5 w-5 text-primary" />
                        </div>

                        <div>
                          <h2 className="text-lg font-semibold">
                            {attempt.examId?.title || "Unknown Exam"}
                          </h2>

                          <div className="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted-foreground">
                            <span className="inline-flex items-center gap-1.5">
                              <CalendarDays className="h-3.5 w-3.5" />
                              {formatDate(attempt.createdAt)}
                            </span>

                            <span className="inline-flex items-center gap-1.5">
                              <Clock3 className="h-3.5 w-3.5" />
                              {formatTime(attempt.createdAt)}
                            </span>
                          </div>
                        </div>
                      </div>

                      {/* Score */}
                      <div className="flex items-center gap-3">
                        <div className="text-right">
                          <p
                            className={`text-2xl font-bold ${getScoreColor(
                              percentage,
                            )}`}
                          >
                            {attempt.score}/{total}
                          </p>

                          <span
                            className={`inline-flex rounded-full px-2.5 py-1 text-xs font-medium ${getScoreBadge(
                              percentage,
                            )}`}
                          >
                            {percentage}%
                          </span>
                        </div>
                      </div>
                    </div>

                    {/* Divider */}
                    <div className="my-5 h-px bg-border" />

                    {/* Result Stats */}
                    <div className="grid grid-cols-3 gap-3">
                      <div className="rounded-xl bg-emerald-500/5 p-3">
                        <div className="flex items-center gap-2">
                          <CheckCircle2 className="h-4 w-4 text-emerald-500" />

                          <span className="text-xs text-muted-foreground">
                            Correct
                          </span>
                        </div>

                        <p className="mt-1 text-lg font-semibold text-emerald-500">
                          {correct}
                        </p>
                      </div>

                      <div className="rounded-xl bg-red-500/5 p-3">
                        <div className="flex items-center gap-2">
                          <XCircle className="h-4 w-4 text-red-500" />

                          <span className="text-xs text-muted-foreground">
                            Wrong
                          </span>
                        </div>

                        <p className="mt-1 text-lg font-semibold text-red-500">
                          {answered - correct}
                        </p>
                      </div>

                      <div className="rounded-xl bg-muted p-3">
                        <div className="flex items-center gap-2">
                          <Clock3 className="h-4 w-4 text-muted-foreground" />

                          <span className="text-xs text-muted-foreground">
                            Skipped
                          </span>
                        </div>

                        <p className="mt-1 text-lg font-semibold">
                          {unanswered}
                        </p>
                      </div>
                    </div>

                    {/* Bottom */}
                    <div className="mt-5 flex justify-end">
                      <Link
                        to={`/quiz-result/${attempt._id}`}
                        className="inline-flex items-center gap-2 rounded-lg border px-4 py-2.5 text-sm font-medium transition hover:bg-muted"
                      >
                        View Result
                        <ArrowRight className="h-4 w-4" />
                      </Link>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </main>
  );
};

export default QuizHistory;
